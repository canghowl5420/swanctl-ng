{
	"luci-app-strongswan-swanctl": {
		"description": "Grant access to the strongSwan swanctl file manager",
		"read": {
			"ubus": {
				"luci.swanctl": [ "status", "profiles", "read", "logs" ]
			}
		},
		"write": {
			"ubus": {
				"luci.swanctl": [ "write", "delete", "activate", "service", "isolate" ]
			}
		}
	}
}
