#!/usr/bin/env ucode

'use strict';

import { chmod, lsdir, mkdir, readfile, rename, stat, unlink, writefile } from 'fs';
import { popen } from 'fs';

const PROFILE_DIR = '/etc/swanctl/profiles';
const CONF_DIR = '/etc/swanctl/conf.d';
const DISABLED_DIR = '/etc/swanctl/conf.d.disabled';
const ACTIVE_FILE = '/etc/swanctl/conf.d/active.conf';
const ACTIVE_MARKER = '/etc/swanctl/active_profile';
const MAX_CONTENT = 256 * 1024;

function failure(message) {
	return { ok: false, error: message };
}

function run(cmd) {
	try {
		return trim(popen(cmd + ' 2>&1')?.read?.('all') ?? '');
	}
	catch (e) {
		return '';
	}
}

function readText(path) {
	try {
		let s = stat(path);
		if (s && s.type == 'file')
			return readfile(path) ?? '';
	}
	catch (e) {
	}
	return null;
}

function normalizeName(name) {
	if (type(name) != 'string')
		return null;

	name = trim(name);
	if (substr(name, length(name) - 5) == '.conf')
		name = substr(name, 0, length(name) - 5);

	if (!match(name, /^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$/))
		return null;

	return name;
}

function profilePath(name) {
	return sprintf('%s/%s.conf', PROFILE_DIR, name);
}

function ensureDirs() {
	for (let dir in [ PROFILE_DIR, CONF_DIR, DISABLED_DIR ]) {
		try {
			let s = stat(dir);
			if (!s)
				mkdir(dir);
		}
		catch (e) {
		}
	}
}

function atomicWrite(path, content) {
	let tmp = path + '.tmp';

	try { unlink(tmp); } catch (e) {}
	if (writefile(tmp, content) != length(content)) {
		try { unlink(tmp); } catch (e) {}
		return false;
	}

	try { chmod(tmp, 0o600); } catch (e) {}
	if (!rename(tmp, path)) {
		try { unlink(tmp); } catch (e) {}
		return false;
	}

	return true;
}

function activeName() {
	let name = readText(ACTIVE_MARKER);
	return name ? trim(name) : '';
}

function listProfiles() {
	ensureDirs();

	let result = [];
	let active = activeName();
	let names = [];

	try { names = lsdir(PROFILE_DIR) ?? []; } catch (e) { names = []; }

	for (let name in names) {
		if (substr(name, length(name) - 5) != '.conf')
			continue;

		let base = substr(name, 0, length(name) - 5);
		let s = null;

		try { s = stat(sprintf('%s/%s', PROFILE_DIR, name)); } catch (e) {}

		push(result, {
			name: base,
			active: (base == active),
			size: s?.size ?? 0,
			mtime: s?.mtime ?? 0
		});
	}

	return sort(result, (a, b) => a.name < b.name ? -1 : (a.name > b.name ? 1 : 0));
}

function listConflicts() {
	let result = [];
	let names = [];

	try { names = lsdir(CONF_DIR) ?? []; } catch (e) { names = []; }

	for (let name in names) {
		if (substr(name, length(name) - 5) == '.conf' && name != 'active.conf')
			push(result, name);
	}

	return sort(result);
}

function pluginList() {
	let result = [];
	let names = [];

	try { names = lsdir('/usr/lib/ipsec/plugins') ?? []; } catch (e) { names = []; }

	for (let name in names) {
		if (!match(name, /^libstrongswan-.+\.so$/))
			continue;

		name = replace(name, /^libstrongswan-/, '');
		name = replace(name, /\.so$/, '');
		push(result, name);
	}

	return sort(result);
}

function parseSwanmon(cmd, errors) {
	let out = run(cmd);
	if (!out) {
		push(errors, sprintf('%s: no output', cmd));
		return null;
	}

	try {
		let data = json(out);
		if (data?.errors && length(data.errors) > 0) {
			for (let err in data.errors)
				push(errors, sprintf('%s: %s', cmd, err.message ?? 'unknown error'));
		}
		return data;
	}
	catch (e) {
		push(errors, sprintf('%s: %s', cmd, e.message));
		return null;
	}
}

function serviceStatus() {
	let out = trim(run('/etc/init.d/swanctl status'));
	return out == 'running' ? 'running' : 'stopped';
}

function serviceAction(action) {
	if (!match(action, /^(start|stop|restart|reload|status)$/))
		return failure('Invalid service action');

	let out = run(sprintf('/etc/init.d/swanctl %s', action));
	return { ok: true, action: action, output: out, service: serviceStatus() };
}

function activateProfile(name) {
	let content = readText(profilePath(name));
	if (content == null)
		return failure('Profile not found');
	if (length(content) == 0)
		return failure('Profile is empty');

	ensureDirs();
	if (!atomicWrite(ACTIVE_FILE, content))
		return failure('Failed to activate profile');
	if (!atomicWrite(ACTIVE_MARKER, name + '\n'))
		return failure('Failed to write active profile marker');

	let reload = serviceAction('reload');

	return {
		ok: true,
		name: name,
		service: serviceStatus(),
		reload: reload?.output ?? '',
		profiles: listProfiles(),
		conflicts: listConflicts()
	};
}

const methods = {
	status: {
		call: function() {
			let errors = [];
			let hasSwanmon = stat('/usr/sbin/swanmon')?.type == 'file';
			let version = null;
			let stats = null;
			let conns = null;
			let sas = null;
			let rawStats = '';

			if (hasSwanmon) {
				let v = parseSwanmon('/usr/sbin/swanmon version', errors);
				let s = parseSwanmon('/usr/sbin/swanmon stats', errors);
				let c = parseSwanmon('/usr/sbin/swanmon list-conns', errors);
				let a = parseSwanmon('/usr/sbin/swanmon list-sas', errors);

				version = v?.data ?? null;
				stats = s?.data ?? null;
				conns = c?.data ?? null;
				sas = a?.data ?? null;
			}
			else {
				rawStats = run('/usr/sbin/swanctl --stats');
				if (!rawStats)
					push(errors, 'swanmon is not installed and swanctl --stats failed');
			}

			let uciOut = run('uci -q show ipsec');
			let uciConns = 0;
			for (let line in split(uciOut, '\n'))
				if (match(line, /=connection$/))
					uciConns++;

			return {
				ok: true,
				service: serviceStatus(),
				profile: activeName(),
				uci_connections: uciConns,
				profiles: listProfiles(),
				conflicts: listConflicts(),
				plugins: pluginList(),
				has_swanmon: hasSwanmon,
				version: version,
				stats: stats,
				conns: conns,
				sas: sas,
				raw_stats: rawStats,
				errors: errors
			};
		}
	},

	profiles: {
		call: function() {
			return {
				ok: true,
				profile: activeName(),
				profiles: listProfiles(),
				conflicts: listConflicts()
			};
		}
	},

	read: {
		args: { name: 'name' },
		call: function(req) {
			let name = normalizeName(req.args?.name);
			if (!name)
				return failure('Invalid profile name');

			let content = readText(profilePath(name));
			if (content == null)
				return failure('Profile not found');

			return { ok: true, name: name, content: content };
		}
	},

	write: {
		args: { name: 'name', content: 'content', activate: 'activate' },
		call: function(req) {
			let name = normalizeName(req.args?.name);
			let content = req.args?.content;

			if (!name)
				return failure('Invalid profile name');
			if (type(content) != 'string' || length(content) == 0)
				return failure('Configuration is empty');
			if (length(content) > MAX_CONTENT)
				return failure('Configuration is too large');

			ensureDirs();

			let path = profilePath(name);
			let old = readText(path);
			if (old != null)
				atomicWrite(path + '.bak', old);

			if (!atomicWrite(path, content))
				return failure('Failed to write profile');

			let result = { ok: true, name: name, profiles: listProfiles() };

			if (req.args?.activate == true || req.args?.activate == 1)
				result.active = activateProfile(name);

			return result;
		}
	},

	delete: {
		args: { name: 'name' },
		call: function(req) {
			let name = normalizeName(req.args?.name);
			if (!name)
				return failure('Invalid profile name');
			if (name == activeName())
				return failure('Cannot delete the active profile');

			let path = profilePath(name);
			if (readText(path) == null)
				return failure('Profile not found');

			try {
				unlink(path);
			}
			catch (e) {
				return failure('Failed to delete profile');
			}

			return { ok: true, profiles: listProfiles() };
		}
	},

	activate: {
		args: { name: 'name' },
		call: function(req) {
			let name = normalizeName(req.args?.name);
			if (!name)
				return failure('Invalid profile name');

			return activateProfile(name);
		}
	},

	service: {
		args: { action: 'action' },
		call: function(req) {
			return serviceAction(req.args?.action);
		}
	},

	logs: {
		args: { lines: 'lines' },
		call: function(req) {
			let lines = int(req.args?.lines ?? 200);
			if (isnan(lines))
				lines = 200;
			if (lines < 50)
				lines = 50;
			if (lines > 1000)
				lines = 1000;

			let logread = stat('/sbin/logread')?.type == 'file' ? '/sbin/logread' : 'logread';
			let charon = run(sprintf('%s -e charon | tail -n %d', logread, lines));
			let swanctl = run(sprintf('%s -e swanctl | tail -n %d', logread, lines));

			return {
				ok: true,
				charon: charon,
				swanctl: swanctl,
				lines: lines
			};
		}
	},

	isolate: {
		call: function() {
			ensureDirs();

			let moved = [];
			let failed = [];
			let names = [];

			try { names = lsdir(CONF_DIR) ?? []; } catch (e) { names = []; }

			for (let name in names) {
				if (substr(name, length(name) - 5) != '.conf' || name == 'active.conf')
					continue;

				let src = sprintf('%s/%s', CONF_DIR, name);
				let dst = sprintf('%s/%s', DISABLED_DIR, name);

				if (rename(src, dst))
					push(moved, name);
				else
					push(failed, name);
			}

			return { ok: length(failed) == 0, moved: moved, failed: failed, conflicts: listConflicts() };
		}
	}
};

return { 'luci.swanctl': methods };
